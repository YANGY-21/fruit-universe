# 复制本文件为 .env.local 并填入真实值：
#   cp .env.example .env.local
#
# 注意：.env.local 已被 .gitignore 排除，不会提交到 git。

# DeepSeek API key —— AI 考官接口用（服务端）
# 在 https://platform.deepseek.com 注册后创建
DEEPSEEK_API_KEY=

# Neon Postgres 连接串 —— 测试结果落库 / 日预算检查
# 在 Neon 控制台 -> Connection details 复制 pooled connection string
# 例：postgres://user:password@host-neon.tech:5432/dbname?sslmode=require
POSTGRES_URL=
